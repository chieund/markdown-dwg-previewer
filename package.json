{
  "name": "dwg-previewer",
  "displayName": "DWG Previewer",
  "description": "View AutoCAD DWG drawings inside VS Code — no AutoCAD needed. Open .dwg files instantly with pan, zoom, layer control and SVG/PNG export.",
  "version": "1.0.1",
  "publisher": "bumkom",
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "dwg",
    "dwg viewer",
    "dwg preview",
    "autocad",
    "cad",
    "cad viewer",
    "drawing",
    "blueprint",
    "floor plan",
    "2d",
    "viewer",
    "architecture",
    "engineering"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chieund/markdown-dwg-previewer"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "dwgPreviewer.dwgView",
        "displayName": "DWG Preview",
        "selector": [
          {
            "filenamePattern": "*.dwg"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "DWG Previewer",
      "properties": {
        "dwgPreviewer.converterPath": {
          "type": "string",
          "default": "",
          "description": "Path to dwg2dxf or ODAFileConverter executable. Leave empty to use the bundled WASM converter."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test out-test/test/*.test.js",
    "test:corpus": "node esbuild.js --corpus && node out-test/corpus.js",
    "package": "vsce package --readme-path MARKETPLACE.md",
    "publish": "vsce publish --readme-path MARKETPLACE.md",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@mlightcad/libdxfrw-web": "0.0.9",
    "@mlightcad/libredwg-web": "^0.7.9"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "dxf-parser": "^1.1.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  }
}
