{
  "name": "dwg-previewer",
  "displayName": "AutoCAD DWG & DXF Previewer",
  "description": "View AutoCAD DWG and DXF drawings inside VS Code — no AutoCAD needed. Open .dwg and .dxf files instantly with pan, zoom, layer control and SVG/PNG export.",
  "version": "1.2.0",
  "publisher": "bumkom",
  "license": "GPL-3.0-or-later",
  "icon": "icon.png",
  "keywords": [
    "dwg",
    "dxf",
    "dwg viewer",
    "dxf viewer",
    "dwg preview",
    "autocad",
    "cad",
    "cad viewer",
    "drawing",
    "blueprint",
    "floor plan",
    "2d",
    "viewer",
    "architecture",
    "engineering"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chieund/markdown-dwg-previewer"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Drawings preview normally. A workspace cannot set dwgPreviewer.converterPath, so it cannot make the extension run a program.",
      "restrictedConfigurations": [
        "dwgPreviewer.converterPath"
      ]
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "dwgPreviewer.dwgView",
        "displayName": "DWG / DXF Preview",
        "selector": [
          {
            "filenamePattern": "*.dwg"
          },
          {
            "filenamePattern": "*.dxf"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "DWG Previewer",
      "properties": {
        "dwgPreviewer.converterPath": {
          "type": "string",
          "default": "",
          "description": "Path to dwg2dxf or ODAFileConverter executable. Leave empty to use the bundled WASM converter. Can only be set in user settings — a workspace cannot choose a program for this extension to run.",
          "scope": "machine"
        }
      }
    },
    "commands": [
      {
        "command": "dwgPreviewer.compareWithHead",
        "title": "Compare with HEAD",
        "category": "DWG",
        "icon": "$(git-compare)"
      },
      {
        "command": "dwgPreviewer.compareWithFile",
        "title": "Compare with File…",
        "category": "DWG"
      },
      {
        "command": "dwgPreviewer.compareSelected",
        "title": "Compare Selected Drawings",
        "category": "DWG"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "dwgPreviewer.compareWithHead",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(dwg|dxf)$/i && !listMultiSelection",
          "group": "3_compare@10"
        },
        {
          "command": "dwgPreviewer.compareWithFile",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(dwg|dxf)$/i && !listMultiSelection",
          "group": "3_compare@11"
        },
        {
          "command": "dwgPreviewer.compareSelected",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(dwg|dxf)$/i && listMultiSelection",
          "group": "3_compare@12"
        }
      ],
      "editor/title": [
        {
          "command": "dwgPreviewer.compareWithHead",
          "when": "activeCustomEditorId == 'dwgPreviewer.dwgView' && resourceScheme == file && gitOpenRepositoryCount != 0",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "dwgPreviewer.compareWithHead",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(dwg|dxf)$/i",
          "group": "3_compare@10"
        },
        {
          "command": "dwgPreviewer.compareWithFile",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(dwg|dxf)$/i",
          "group": "3_compare@11"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "dwgPreviewer.compareWithHead",
          "when": "scmProvider == git && resourceExtname =~ /^\\.(dwg|dxf)$/i",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "dwgPreviewer.compareSelected",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test out-test/test/*.test.js",
    "test:corpus": "node esbuild.js --corpus && node out-test/corpus.js",
    "package": "vsce package --readme-path MARKETPLACE.md",
    "publish": "vsce publish --readme-path MARKETPLACE.md",
    "vscode:prepublish": "npm run build",
    "preview": "node esbuild.js && node esbuild.js --preview && node out-test/preview.js"
  },
  "dependencies": {
    "@mlightcad/libredwg-web": "^0.7.9"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "dxf-parser": "^1.1.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  }
}
