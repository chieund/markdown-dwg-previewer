# Everything the extension needs is bundled into out/extension.js, out/worker.js and
# out/webview/main.js. The WASM converter (@mlightcad/libredwg-web) is kept
# in node_modules since it loads .wasm at runtime — converter.ts resolves it
# relative to out/.

.git/**
.github/**
.vscode/**
.claude/**
node_modules/**
!node_modules/@mlightcad/libredwg-web/**

src/**
test/**
scripts/**
docs/**
assets/**

# Internal development docs — not shipped to users.
# The Marketplace page comes from MARKETPLACE.md instead (see the `package`
# script's --readme-path); README.md is the internal doc for the team.
README.md
ARCHITECTURE.md
PROGRESS.md

esbuild.js
tsconfig.json

out-test/**
**/*.map
**/*.ts
**/.gitignore
**/tsconfig.json
tsconfig.*.json
